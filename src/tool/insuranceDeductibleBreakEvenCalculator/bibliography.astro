---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import { insuranceDeductibleBreakEvenCalculator } from './entry';
import type { KnownLocale } from '../../types';
interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const content = await insuranceDeductibleBreakEvenCalculator.i18n[locale]?.() ?? await insuranceDeductibleBreakEvenCalculator.i18n.en?.();
---

{content && <SharedBibliography links={content.bibliography} />}
